{% extends 'back/layout.html.twig' %}

{% block breadcrumb %}
    {% set pathsNames = {
        ('home'|trans({}, 'Menu')): 'back_index',
    } %}

    <div class="breadcrumbs text-sm">
        <ul>
            {% for name, route in pathsNames %}
                <li>
                    {% if route is defined and route is not empty %}
                        <a href="{{ path(route) }}" class="text-gray-700 hover:underline">
                            {{ name|upper }}
                        </a>
                    {% else %}
                        <span class="text-orange-400">{{ name|upper }}</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}

{% block content %}
    <h1 class="text-3xl font-bold no-underline text-lime-600">
        Dashboard
    </h1>

    <form method="get" class="form-control max-w-fit flex flex-row items-center gap-6 bg-base-100 p-4 my-8 rounded-xl shadow">
        <div class="form-control w-auto flex flex-row items-center gap-2 mb-0">
            <label for="range" class="label label-text m-0">Période</label>
            <select name="range" id="range" class="select select-bordered w-full md:w-40">
                <option value="7d"  {{ range == '7d' ? 'selected' : '' }}>7 jours</option>
                <option value="30d" {{ range == '30d' ? 'selected' : '' }}>30 jours</option>
                <option value="custom" {{ range == 'custom' ? 'selected' : '' }}>Personnalisée</option>
            </select>
        </div>

        <div class="form-control w-auto flex flex-row items-center gap-2 mb-0">
            <label for="from" class="label label-text m-0">Du</label>
            <input type="date" name="from" id="from" value="{{ from }}" class="input input-bordered w-full md:w-40" {{ range != 'custom' ? 'disabled' : '' }}>
        </div>

        <div class="form-control w-auto flex flex-row items-center gap-2 mb-0">
            <label for="to" class="label label-text m-0">Au</label>
            <input type="date" name="to" id="to" value="{{ to }}" class="input input-bordered w-full md:w-40" {{ range != 'custom' ? 'disabled' : '' }}>
        </div>

        <div class="form-control w-auto flex flex-row items-center gap-2 mb-0">
            <button type="submit" class="btn bg-lime-600 hover:bg-lime-700 text-white">Appliquer</button>
        </div>
    </form>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mt-8">
        <!-- Carte 1 -->
        <div class="bg-white shadow rounded-xl p-5">
            <h3 class="text-md font-semibold text-gray-700 mb-4">Répartition par humeur</h3>
            <div class="relative h-64 overflow-hidden">
                <canvas id="chartMood" class="w-full h-full block" aria-label="Graphique des playlists par mood" role="img"></canvas>
            </div>
            <div class="text-right mt-4">
                <a href="#" class="text-sm text-blue-600 hover:underline">Afficher plus</a>
            </div>
        </div>

        <!-- Carte 2 -->
        <div class="bg-white shadow rounded-xl p-5">
            <h3 class="text-md font-semibold text-gray-700 mb-4">Répartition par activité</h3>
            <div class="relative h-64 overflow-hidden">
                <canvas id="chartActivity" class="w-full h-full block" aria-label="Graphique des playlists par activité" role="img"></canvas>
            </div>
            <div class="text-right mt-4">
                <a href="#" class="text-sm text-blue-600 hover:underline">Afficher plus</a>
            </div>
        </div>

        <!-- Carte 3 -->
        <div class="bg-white shadow rounded-xl p-5">
            <h3 class="text-md font-semibold text-gray-700 mb-4">Dernières connexions</h3>
            <table class="min-w-full text-sm">
                <thead class="text-xs uppercase text-gray-500 bg-gray-50 border-b">
                    <tr>
                        <th class="py-2 pr-4">Email</th>
                        <th class="py-2">Dernière connexion</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in stats.lastConnectedUsers %}
                        <tr class="border-b last:border-0">
                            <td class="py-2 pr-4">{{ user.email }}</td>
                            <td class="py-2">{{ user.lastLoginAt ? user.lastLoginAt|date('Y-m-d H:i') : '—' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  (function() {
      // Prepare data (arrays of {mood, total} and {activity, total})
    const moodData = {{ (stats.playlistsByMood ?? [])|json_encode|raw }};
    const activityData = {{ (stats.playlistsByActivity ?? [])|json_encode|raw }};

      console.log('[Dashboard] moodData =', moodData);
      console.log('[Dashboard] activityData =', activityData);

      // Mood chart
    const moodEl = document.getElementById('chartMood');
    if (moodEl && Array.isArray(moodData) && moodData.length) {
      const labels = moodData.map(r => (typeof r.mood === 'string' ? r.mood : (r.mood && r.mood.value) ? r.mood.value : ''));
      const values = moodData.map(r => Number(r.total || 0));
      new Chart(moodEl.getContext('2d'), {
        type: 'doughnut',
        data: {
          labels,
          datasets: [{ label: 'Playlists par mood', data: values }]
        },
        options: {
          responsive: true,
          resizeDelay: 200,
          maintainAspectRatio: false,
          devicePixelRatio: 1,
          plugins: { legend: { position: 'bottom' } }
        }
      });
    }

    // Activity chart
    const actEl = document.getElementById('chartActivity');
    if (actEl && Array.isArray(activityData) && activityData.length) {
      const labels = activityData.map(r => (typeof r.activity === 'string' ? r.activity : (r.activity && r.activity.value) ? r.activity.value : ''));
      const values = activityData.map(r => Number(r.total || 0));
      new Chart(actEl.getContext('2d'), {
        type: 'doughnut',
        data: {
          labels,
          datasets: [{ label: 'Playlists par activité', data: values }]
        },
        options: {
          responsive: true,
          resizeDelay: 200,
          maintainAspectRatio: false,
          devicePixelRatio: 1,
          plugins: { legend: { position: 'bottom' } }
        }
      });
    }
  })();
</script>
{% endblock %}
