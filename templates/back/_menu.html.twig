{% trans_default_domain 'Menu' %}
{% block menu %}
    {% set currentPage = app.request.get('_route') %}
    {% set linkClass = 'relative flex flex-row items-center h-11 focus:outline-none hover:bg-gray-50 text-gray-600 hover:text-gray-800 border-l-4 border-transparent hover:border-indigo-500 pr-6 no-underline' %}
    {% set activeClass = 'bg-indigo-100 border-indigo-500' %}
    <div class="min-h-screen flex flex-col flex-auto flex-shrink-0 antialiased bg-gray-50 text-gray-800">
        <div class="fixed flex flex-col top-0 left-0 w-64 bg-white h-full">
            <div class="overflow-y-auto overflow-x-hidden flex-grow">
                <ul class="flex flex-col py-4 space-y-1">
                    <li>
                        <a href="{{ path('back_index')}}" class="{{ linkClass }} {{ 'back_index' == app.request.get('_route') ? activeClass : ''}}">
                        <span class="inline-flex justify-center items-center ml-4">
                           {{ ux_icon('fa6-solid:house', {width: '18px', height: '18px'}) }}
                        </span>
                            <span class="ml-2 text-sm tracking-wide truncate">{{ 'home'|trans({}, 'Menu') }}</span>
                        </a>
                    </li>
                    <li>
                        {% import 'back/administrator/menu.html.twig' as menuAdmin %}
                        {% set active = menuAdmin.activeMenu()%}
                        <a href="{{ path('back_administrator_index')}}" class="{{ linkClass }} {{ active  ? activeClass : '' }}">
                        <span class="inline-flex justify-center items-center ml-4">
                            {{ ux_icon('fa6-solid:user-shield', {width: '18px', height: '18px'}) }}
                        </span>
                            <span class="ml-2 text-sm tracking-wide truncate">{{ 'administrator'|trans({}, 'Menu') }}</span>
                        </a>
                    </li>
                    <li>
                        {% import 'back/answer/menu.html.twig' as menuAnswer %}
                        {% set active = menuAnswer.activeMenu()%}
                        <a href="{{ path('back_answer_index')}}" class="{{ linkClass }} {{ active  ? activeClass : '' }}">
                            <span class="inline-flex justify-center items-center ml-4">
                                {{ ux_icon('fa6-solid:file-pen', {width: '18px', height: '18px'}) }}
                            </span>
                            <span class="ml-2 text-sm tracking-wide truncate">{{ 'answer'|trans({}, 'Menu') }}</span>
                        </a>
                    </li>
                    <li>
                        {% import 'back/playlist/menu.html.twig' as menuPlaylist %}
                        {% set active = menuPlaylist.activeMenu()%}
                        <a href="{{ path('back_playlist_index')}}" class="{{ linkClass }} {{ active  ? activeClass : '' }}">
                        <span class="inline-flex justify-center items-center ml-4">
                           {{ ux_icon('fa6-solid:music', {width: '18px', height: '18px'}) }}
                        </span>
                            <span class="ml-2 text-sm tracking-wide truncate">{{ 'playlist'|trans({}, 'Menu') }}</span>
                        </a>
                    </li>
                    <li>
                        {% import 'back/question/menu.html.twig' as menuQuestion %}
                        {% set active = menuQuestion.activeMenu()%}
                        <a href="{{ path('back_question_index')}}" class="{{ linkClass }} {{ active  ? activeClass : '' }}">
                        <span class="inline-flex justify-center items-center ml-4">
                            {{ ux_icon('fa6-solid:circle-question', {width: '18px', height: '18px'}) }}
                        </span>
                            <span class="ml-2 text-sm tracking-wide truncate">{{ 'question'|trans({}, 'Menu') }}</span>
                        </a>
                    </li>
                    <li>
                        {% import 'back/recommendation/menu.html.twig' as menuRecommendation %}
                        {% set active = menuRecommendation.activeMenu()%}
                        <a href="{{ path('back_recommendation_index')}}" class="{{ linkClass }} {{ active  ? activeClass : '' }}">
                        <span class="inline-flex justify-center items-center ml-4">
                            {{ ux_icon('fa6-solid:circle-question', {width: '18px', height: '18px'}) }}
                        </span>
                            <span class="ml-2 text-sm tracking-wide truncate">{{ 'recommmendation'|trans({}, 'Menu') }}</span>
                        </a>
                    </li>
                    <li>
                        {% import 'back/user/menu.html.twig' as menuUser %}
                        {% set active = menuUser.activeMenu()%}
                        <a href="{{ path('back_user_index')}}" class="{{ linkClass }} {{ active  ? activeClass : '' }}">
                        <span class="inline-flex justify-center items-center ml-4">
                            {{ ux_icon('fa6-solid:user', {width: '18px', height: '18px'}) }}
                        </span>
                            <span class="ml-2 text-sm tracking-wide truncate">{{ 'user'|trans({}, 'Menu') }}</span>
                        </a>
                    </li>
                   <li>
                        <a href="{{ path('logout') }}" class="{{ linkClass }}">
                            <span class="inline-flex justify-center items-center ml-4">
                                {{ ux_icon('fa6-solid:arrow-right-from-bracket', {width: '18px', height: '18px'}) }}
                            </span>
                            <span class="ml-2 text-sm tracking-wide truncate">{{ 'logout'|trans({}, 'Menu') }}</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
{% endblock %}
