{% extends 'back/layout.html.twig' %}

{% block breadcrumb %}
    {% set pathsNames = {
        ('home'|trans({}, 'Menu')): 'back_index',
        ('title'|trans({}, 'Answer')): 'back_answer_index',
    } %}

    <div class="breadcrumbs text-sm">
        <ul>
            {% for name, route in pathsNames %}
                <li>
                    {% if route is defined and route is not empty %}
                        <a href="{{ path(route) }}" class="text-gray-700 hover:underline">
                            {{ name|upper }}
                        </a>
                    {% else %}
                        <span class="text-orange-400">
                        {{ name|upper }}
                    </span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}

{% block content %}
    <h1 class="text-3xl font-bold no-underline text-lime-600">
        Liste des réponses
    </h1>

    <div class="overflow-x-auto">
        <table class="table table-zebra">
            <!-- head -->
            <thead>
                <tr>
                    <th class="text-center">{{ 'username'|trans({}, 'Answer') }}</th>
                    <th class="text-center">{{ 'question'|trans({}, 'Answer') }}</th>
                    <th class="text-center">{{ 'réponses'|trans({}, 'Answer') }}</th>
                    <th class="text-center">{{ 'actions'|trans({}, 'Crud') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for question in pagination %}
                    <tr>
                        <td>{{ question.user.username ?? 'N/A' }}</td>
                        <td>{{ question.label }}</td>
                        <td>{{ question.answer.label ?? ''}}</td>
                        <td>
                            <a class="d-flex justify-content-center text-decoration-none fa-lg"
                               href="{{ path('back_question_delete', {'id': question.id}) }}"
                               title="{{ 'delete.title'|trans([], 'Question') }}">
                                {{ ux_icon('fa6-regular:trash-can', {width: '20px', height: '20px'}) }}
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}